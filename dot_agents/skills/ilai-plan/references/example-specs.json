  {
    "type": "sequence",
    "slug": "mcp-auth-sequence",
    "title": "Every call carries a short-lived token bound to /mcp",
    "desc": "The first call gets a 401 pointing at discovery. The client signs the staff member in behind Cloudflare Access and gets a token for /mcp only. Each call is checked for scope, then runs the procedure as the staff member and is audited.",
    "actors": [
      {
        "id": "client",
        "name": "Claude Code",
        "sub": "staff member",
        "kind": "input"
      },
      {
        "id": "as",
        "name": "Authorization server",
        "sub": "behind Access",
        "kind": "external"
      },
      {
        "id": "svc",
        "name": "backoffice-service",
        "sub": "/mcp",
        "tag": "NEW",
        "kind": "focal"
      }
    ],
    "steps": [
      {
        "from": "client",
        "to": "svc",
        "label": "POST /mcp, no token",
        "kind": "http"
      },
      {
        "from": "svc",
        "to": "client",
        "label": "401 + resource metadata",
        "kind": "return"
      },
      {
        "from": "client",
        "to": "as",
        "label": "authorize (PKCE) + consent",
        "kind": "http"
      },
      {
        "from": "as",
        "to": "client",
        "label": "access token, aud = /mcp",
        "kind": "return"
      },
      {
        "from": "client",
        "to": "svc",
        "label": "POST /mcp + bearer",
        "kind": "http"
      },
      {
        "from": "svc",
        "to": "svc",
        "label": "verify JWT + staff"
      },
      {
        "fragment": "alt",
        "regions": [
          {
            "guard": "[tool beyond the grant]",
            "steps": [
              {
                "from": "svc",
                "to": "client",
                "label": "403 insufficient_scope",
                "kind": "return"
              }
            ]
          },
          {
            "guard": "[else]",
            "steps": [
              {
                "from": "svc",
                "to": "svc",
                "label": "procedure as staff \u00b7 audit"
              }
            ]
          }
        ]
      },
      {
        "from": "svc",
        "to": "client",
        "label": "result",
        "kind": "headline"
      }
    ]
  },
