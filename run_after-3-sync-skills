#!/bin/bash

set -e

echox() {
  printf "[\033[1;32msync-skills\033[0m] %s\n" "$1"
}

# Third-party agent skills, installed via the `skills` CLI into ~/.agents/skills.
# Own skills are tracked directly in dot_agents/skills.
SKILLS=(
  "herdrdev/herdr herdr"
  "mattpocock/skills handoff"
  "terrylica/cc-skills chezmoi-workflows"
  "zarazhangrui/frontend-slides frontend-slides"
  "Doist/todoist-cli todoist-cli"
  "cathrynlavery/diagram-design diagram-design"
)

# Podium exposes npx only once the workspace toolchain is installed (see install.sh).
command -v npx >/dev/null || exit 0

LOCK="$HOME/.agents/.skill-lock.json"
STAMP="$HOME/.agents/.skills-updated"
LOG="$HOME/.cache/sync-skills.log"

missing=()
for entry in "${SKILLS[@]}"; do
  read -r source skill <<<"$entry"
  jq -e --arg s "$skill" '.skills[$s]' "$LOCK" >/dev/null 2>&1 || missing+=("$entry")
done
# Updates run weekly; every apply would cost seconds of npx and git for nothing new.
[[ ${#missing[@]} -eq 0 && -n "$(find "$STAMP" -mtime -7 2>/dev/null)" ]] && exit 0

# Installs clone each source repo (~15s for a fresh home), so they run in the background and the apply returns.
if [[ ${#missing[@]} -gt 0 ]]; then
  echox "Installing ${#missing[@]} and updating skills in the background (log: $LOG)"
else
  echox "Updating skills in the background (log: $LOG)"
fi
mkdir -p "${LOG%/*}"
cd "$HOME"
nohup bash -c '
  for entry in "$@"; do
    read -r source skill <<<"$entry"
    echo "Installing $skill from $source"
    npx -y skills add "$source" -g -s "$skill" -a claude-code -y
  done
  echo "Updating skills"
  npx -y skills update -g -y && touch "'"$STAMP"'"
' sync-skills "${missing[@]}" >"$LOG" 2>&1 &
