#!/bin/bash
# Deep-merge the tracked keys from claude-settings.json over the live file.
# Keys Claude Code or other tools write (hooks, autoMode, ...) are kept as-is.
# Our hooks are appended per event when missing, since `*` would replace those arrays.
{{- $plugins := joinPath .chezmoi.homeDir ".config/herdr/plugins" }}
jq -j -s --argjson hooks '[
  ["Stop", "python3 ~/.claude/hooks/herdr-notify.py"],
  ["Notification", "python3 ~/.claude/hooks/herdr-notify.py"],
  ["Stop", "bash '\''{{ $plugins }}/claude-recap/hook.sh'\''"],
  ["SessionEnd", "bash '\''{{ $plugins }}/claude-recap/hook.sh'\''"],
  ["UserPromptSubmit", "bash '\''{{ $plugins }}/claude-recap/hook.sh'\''"],
  ["Stop", "sh '\''{{ $plugins }}/claude-prs/hook.sh'\''"],
  ["SessionEnd", "sh '\''{{ $plugins }}/claude-prs/hook.sh'\''"],
  ["SessionStart", "sh '\''{{ $plugins }}/claude-prs/hook.sh'\''"],
  ["PostToolUse", "sh '\''{{ $plugins }}/claude-prs/hook.sh'\''"]
]' '
  reduce .[] as $x ({}; . * $x)
  | reduce $hooks[] as [$e, $cmd] (.;
      if any(.hooks[$e][]?.hooks[]; .command == $cmd) then .
      else .hooks[$e] += [{hooks: [{type: "command", command: $cmd, timeout: 10}]}] end)
' - <(cat <<'EOF'
{{ include "claude-settings.json" }}
EOF
)
