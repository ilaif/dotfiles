#!/bin/bash
# Operate claude-model-router (see ~/.config/claude-model-router/README.md).
set -euo pipefail
label=dev.claude-model-router
svc="gui/$(id -u)/$label"
plist="$HOME/Library/LaunchAgents/$label.plist"
log="$HOME/Library/Logs/claude-model-router.log"
private="$HOME/.claude/settings.private.json"
settings="$HOME/.claude/settings.json"
url=http://127.0.0.1:8787

set_env() { # $1 = jq filter applied to both settings files
  for f in "$private" "$settings"; do
    [[ -f $f ]] || continue
    jq --indent 2 "$1" "$f" >"$f.tmp" && cat "$f.tmp" >"$f" && rm "$f.tmp"
  done
}

case "${1:-status}" in
status)
  launchctl print "$svc" 2>/dev/null | grep -E $'^\t(state|pid|last exit code) =' || echo "not loaded"
  curl -s -o /dev/null -m 2 -w "health: %{http_code}\n" -I "$url/api/hello" || echo "health: unreachable"
  echo "claude uses: $(jq -r '.env.HTTPS_PROXY // "api.anthropic.com directly (router off)"' "$settings")"
  ;;
restart) launchctl kickstart -k "$svc" && echo restarted ;;
start) launchctl bootstrap "gui/$(id -u)" "$plist" && echo started ;;
stop) launchctl bootout "$svc" && echo "stopped (run '$0 off' too, or new claude sessions can't connect)" ;;
logs) tail -n 50 -f "$log" ;;
off) set_env 'del(.env.HTTPS_PROXY, .env.NO_PROXY, .env.NODE_EXTRA_CA_CERTS, .env.ANTHROPIC_BASE_URL, .env.ANTHROPIC_CUSTOM_HEADERS, .env.CLAUDE_CODE_DISABLE_ADVISOR_TOOL)' && echo "new claude sessions go direct to Anthropic; Foundry models and the Copilot fallback unavailable" ;;
on) set_env ".env.HTTPS_PROXY = \"$url\" | .env.NO_PROXY = \"localhost,127.0.0.1,::1\" | .env.NODE_EXTRA_CA_CERTS = \"$HOME/.config/claude-model-router/tls/ca.pem\" | .env.ANTHROPIC_CUSTOM_HEADERS = \"x-claude-router-fallback: 1\" | .env.CLAUDE_CODE_DISABLE_ADVISOR_TOOL = \"1\" | del(.env.ANTHROPIC_BASE_URL)" && echo "new claude sessions (CLI and Desktop) use the router with the Copilot fallback" ;;
*) echo "usage: claude-router [status|restart|start|stop|logs|off|on]" >&2; exit 2 ;;
esac
