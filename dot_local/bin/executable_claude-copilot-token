#!/bin/sh
set -eu

token_file="$HOME/.local/share/copilot-api/github_token"
if [ ! -s "$token_file" ]; then
  printf '%s\n' 'Copilot login required: npm exec --yes --package=copilot-api@0.7.0 -- copilot-api auth' >&2
  exit 1
fi

{
  printf 'header = "Authorization: token %s"\n' "$(tr -d '\r\n' < "$token_file")"
} | curl --silent --show-error --fail-with-body --max-time 30 --config - \
  --header 'Accept: application/json' \
  --header 'Editor-Version: vscode/1.104.3' \
  --header 'Editor-Plugin-Version: copilot-chat/0.26.7' \
  --user-agent 'GitHubCopilotChat/0.26.7' \
  'https://api.github.com/copilot_internal/v2/token' \
  | jq -er 'if (.token | type) == "string" and (.token | length) > 0 then "Bearer " + .token else error("Copilot token exchange failed") end'
