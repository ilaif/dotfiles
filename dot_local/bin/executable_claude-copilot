#!/bin/sh
set -eu

model="${CLAUDE_COPILOT_MODEL:-claude-opus-5.5}"
export HTTPS_PROXY=http://127.0.0.1:8787
export NO_PROXY=localhost,127.0.0.1,::1
export NODE_EXTRA_CA_CERTS="$HOME/.config/claude-model-router/tls/ca.pem"
export ANTHROPIC_MODEL="copilot/$model"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$ANTHROPIC_MODEL"
export CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1
unset ANTHROPIC_BASE_URL CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
exec "$HOME/.local/bin/claude" "$@"
