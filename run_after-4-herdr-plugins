#!/bin/bash

set -e

echox() {
  printf "[\033[1;32mherdr-plugins\033[0m] %s\n" "$1"
}

command -v herdr >/dev/null || exit 0

INSTALLED="$(herdr plugin list)"

# Own plugins are tracked in dot_config/herdr/plugins and linked in place.
for plugin in claude-prs claude-recap dev-space spaces-control terminal-input; do
  grep -q "local:$HOME/.config/herdr/plugins/$plugin\]" <<<"$INSTALLED" && continue
  echox "Linking $plugin"
  herdr plugin link "$HOME/.config/herdr/plugins/$plugin"
done

# Third-party plugins.
grep -q "github:smarzban/herdr-file-viewer" <<<"$INSTALLED" ||
  { echox "Installing herdr-file-viewer"; herdr plugin install smarzban/herdr-file-viewer; }
